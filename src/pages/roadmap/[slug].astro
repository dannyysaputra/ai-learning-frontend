---
import Layout from "../../layouts/Layout.astro";

interface Resource {
  title: string;
  url: string;
}
interface Step {
  title: string;
  description: string;
  resources: Resource[];
}
interface Roadmap {
  id: number; 
  documentId: string;
  title: string;
  description: string;
  steps: Step[]; 
  likes: number;
  dislikes: number;
}

const STRAPI_API_URL = import.meta.env.STRAPI_API_URL;

export async function getStaticPaths() {
  const response = await fetch(`${STRAPI_API_URL}/api/roadmaps`);
  if (!response.ok) return [];
  const { data } = await response.json();
  if (!data) return [];

  return data.map((roadmap: any) => ({
    params: { slug: roadmap.slug },
  }));
}

const { slug } = Astro.params;
const response = await fetch(
  `${STRAPI_API_URL}/api/roadmaps?filters[slug][$eq]=${slug}`
);
const { data } = await response.json();

if (!data || data.length === 0) {
  return Astro.redirect("/404");
}

const roadmap: Roadmap = data[0]; 
---

<Layout title={roadmap.title}>
  <main class="bg-gray-50/50 py-12 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-gray-500 hover:text-blue-600 font-medium group"
        >
          Lihat Semua Roadmap
        </a>
        <button
          id="share-button"
          class="inline-flex items-center gap-2 text-gray-500 hover:text-blue-600 font-medium"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.684 13.342C8.886 12.938 9 12.482 9 12s-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.368a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"
            ></path></svg
          >
          Bagikan
        </button>
      </div>

      <div
        class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 mb-8"
      >
        <h1 class="text-4xl md:text-5xl font-extrabold ...">
          {roadmap.title}
        </h1>
        <p class="mt-4 text-lg ...">{roadmap.description}</p>
      </div>

      <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
        {
          roadmap.steps.map((step, index) => (
            <div class="step-container relative pl-12 pb-12 border-l-2 border-gray-200">
              {/* Lingkaran Nomor */}
              <div class="absolute -left-[1.30rem] top-0 flex items-center justify-center w-10 h-10 bg-blue-100 text-blue-600 rounded-full font-bold">
                {index + 1}
              </div>
              <h2 class="text-2xl font-bold text-gray-800">{step.title}</h2>
              <p class="mt-2 text-gray-600">{step.description}</p>

              {step.resources && step.resources.length > 0 && (
                <div class="mt-4">
                  <h4 class="font-semibold text-gray-700">Sumber Belajar:</h4>
                  <ul class="list-none mt-2 space-y-2">
                    {step.resources.map((resource) => (
                      <li>
                        <a
                          href={resource.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 text-blue-600 hover:underline"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                          </svg>
                          {resource.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <div
        class="mt-8 text-center bg-white p-8 rounded-xl shadow-sm border border-gray-200"
      >
        <h3 class="text-xl font-semibold text-gray-800">
          Apakah roadmap ini membantu?
        </h3>
        <div class="flex justify-center items-center gap-4 mt-4">
          <button
            data-type="like"
            class="rating-button flex items-center gap-2 px-4 py-2 rounded-lg bg-green-100 text-green-800 hover:bg-green-200 transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="currentColor"
              ><path
                d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333V17a1 1 0 001 1h8a1 1 0 001-1v-6.667a2.25 2.25 0 00-.75-1.666l-2.25-2.25a2.25 2.25 0 00-1.666-.75h-1.5a2.25 2.25 0 00-2.25 2.25v6.667z"
              ></path></svg
            >
            <span id="likes-count">{roadmap.likes}</span>
          </button>
          <button
            data-type="dislike"
            class="rating-button flex items-center gap-2 px-4 py-2 rounded-lg bg-red-100 text-red-800 hover:bg-red-200 transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="currentColor"
              ><path
                d="M18 9.5a1.5 1.5 0 11-3 0v-6a1.5 1.5 0 013 0v6zM14 9.667V3a1 1 0 00-1-1H5a1 1 0 00-1 1v6.667a2.25 2.25 0 00.75 1.666l2.25 2.25a2.25 2.25 0 001.666.75h1.5a2.25 2.25 0 002.25-2.25V9.667z"
              ></path></svg
            >
            <span id="dislikes-count">{roadmap.dislikes}</span>
          </button>
        </div>
        <p id="rating-feedback" class="mt-2 text-sm text-gray-500 h-4"></p>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ roadmapDocumentId: roadmap.documentId }}>
  const shareButton = document.getElementById("share-button");
  const toastNotification = document.getElementById("toast-notification"); // Ambil elemen toast

  if (shareButton && toastNotification) {
    shareButton.addEventListener("click", () => {
      navigator.clipboard
        .writeText(window.location.href)
        .then(() => {
          toastNotification.classList.remove("opacity-0", "translate-y-10");
          setTimeout(() => {
            toastNotification.classList.add("opacity-0", "translate-y-10");
          }, 3000); // 3000 milidetik = 3 detik
        })
        .catch((err) => console.error("Gagal menyalin link:", err));
    });
  }

  const ratingButtons = document.querySelectorAll(".rating-button");
  const likesCountEl = document.getElementById("likes-count");
  const dislikesCountEl = document.getElementById("dislikes-count");
  const ratingFeedbackEl = document.getElementById("rating-feedback");

  ratingButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const type = button.getAttribute("data-type");

      // Nonaktifkan tombol untuk mencegah klik ganda
      ratingButtons.forEach((btn) => (btn.disabled = true));
      if (ratingFeedbackEl) ratingFeedbackEl.textContent = "Menyimpan...";

      try {
        const response = await fetch("/api/rate-roadmap", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ roadmapDocumentId, type }),
        });

        if (!response.ok) throw new Error("Gagal menyimpan rating");

        const updatedRoadmap = await response.json();

        // Perbarui tampilan dengan data baru
        if (likesCountEl) likesCountEl.textContent = updatedRoadmap.likes;
        if (dislikesCountEl)
          dislikesCountEl.textContent = updatedRoadmap.dislikes;
        if (ratingFeedbackEl)
          ratingFeedbackEl.textContent = "Terima kasih atas masukan Anda!";
      } catch (error) {
        console.error(error);

        if (ratingFeedbackEl)
          ratingFeedbackEl.textContent = "Gagal menyimpan. Coba lagi.";
        // Aktifkan kembali tombol jika gagal
        ratingButtons.forEach((btn) => (btn.disabled = false));
      }
    });
  });
</script>

<style is:global>
  .step-container:last-of-type {
    border-left: none; /* Hapus garis vertikal untuk item terakhir */
    padding-bottom: 0;
  }
</style>
