---
import Layout from "../layouts/Layout.astro";

interface Category {
  id: number;
  name: string;
}

interface Roadmap {
  id: number;
  title: string;
  slug: string;
  description: string;
  category: Category | null;
}

const STRAPI_URL = import.meta.env.STRAPI_API_URL;
let roadmaps: Roadmap[] = [];
try {
  const response = await fetch(
    `${STRAPI_URL}/api/roadmaps?sort=createdAt:desc&populate=category`
  );

  if (response.ok) {
    const { data } = await response.json();
    roadmaps = data;
  }
} catch (error) {
  console.error("Gagal mengambil data roadmap dari Strapi:", error);
}
---

<Layout title="AI Learning Path Generator">
  <section class="w-full py-12 md:py-24 lg:py-32 bg-gray-50">
    <div class="container mx-auto px-4 md:px-6">
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-12 xl:gap-16 items-center">
        <div class="space-y-4">
          <div
            class="inline-block rounded-lg bg-blue-100 px-3 py-1 text-sm text-blue-800 font-semibold"
          >
            Powered by AI
          </div>
          <h1
            class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl lg:text-6xl/none"
          >
            Buat Jalur Belajar Personal Anda
          </h1>
          <p class="max-w-[600px] text-gray-500 md:text-xl">
            Masukkan topik apa pun, dan biarkan AI merancang roadmap belajar
            langkah demi langkah yang terstruktur hanya untuk Anda.
          </p>
          <form id="topic-form" class="w-full max-w-md space-y-2 mt-6">
            <input
              type="text"
              id="topic"
              name="topic"
              class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
              placeholder="Contoh: Belajar Python untuk Data Science..."
              required
            />
            <button
              type="submit"
              id="submit-button"
              class="w-full bg-blue-600 text-white font-bold py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors duration-300 disabled:bg-gray-400 flex items-center justify-center gap-2"
            >
              <span id="button-text">Buat Jalur Belajar</span>
              <span id="loading-spinner" class="hidden">
                <svg
                  class="animate-spin h-5 w-5 text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
              </span>
            </button>
            <p id="error-message" class="text-red-500 text-sm text-center h-4">
            </p>
          </form>
        </div>
        <img
          src="/hero-illustration.svg"
          alt="AI Learning Illustration"
          class="mx-auto aspect-video overflow-hidden rounded-xl object-cover sm:w-full lg:order-last lg:aspect-square"
          width="550"
          height="550"
        />
      </div>
    </div>
  </section>

  <section class="w-full py-12 md:py-24 bg-white">
    <div class="container mx-auto px-4 md:px-6">
      <div
        class="flex flex-col items-center justify-center space-y-4 text-center mb-12"
      >
        <div class="space-y-2">
          <div class="inline-block rounded-lg bg-gray-100 px-3 py-1 text-sm">
            Hanya 3 Langkah Mudah
          </div>
          <h2 class="text-3xl font-bold tracking-tighter sm:text-5xl">
            Bagaimana Ini Bekerja?
          </h2>
          <p class="max-w-[900px] text-gray-500 md:text-xl/relaxed">
            Dari ide menjadi rencana belajar yang terstruktur dalam hitungan
            detik.
          </p>
        </div>
      </div>
      <div
        class="mx-auto grid max-w-5xl items-start gap-8 sm:grid-cols-3 sm:gap-12"
      >
        <div class="grid gap-1 text-center">
          <div class="flex justify-center items-center mb-4">
            <div
              class="flex items-center justify-center rounded-full bg-blue-100 h-16 w-16"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold">1. Masukkan Topik</h3>
          <p class="text-sm text-gray-500">
            Tulis apa pun yang ingin Anda pelajari, mulai dari coding, memasak,
            hingga astrofisika.
          </p>
        </div>
        <div class="grid gap-1 text-center">
          <div class="flex justify-center items-center mb-4">
            <div
              class="flex items-center justify-center rounded-full bg-blue-100 h-16 w-16"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold">2. Biarkan AI Bekerja</h3>
          <p class="text-sm text-gray-500">
            Model AI canggih kami akan menganalisis topik Anda dan menyusun
            kurikulum yang logis.
          </p>
        </div>
        <div class="grid gap-1 text-center">
          <div class="flex justify-center items-center mb-4">
            <div
              class="flex items-center justify-center rounded-full bg-blue-100 h-16 w-16"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 16.382V5.618a1 1 0 00-1.447-.894L15 7m-6 3v10m6-10v10"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold">3. Dapatkan Roadmap</h3>
          <p class="text-sm text-gray-500">
            Anda akan langsung mendapatkan jalur belajar terstruktur yang siap
            untuk diikuti.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="w-full py-12 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 md:px-6">
      <div
        class="flex flex-col items-center justify-center space-y-4 text-center"
      >
        <h2 class="text-3xl font-bold tracking-tighter sm:text-5xl">
          Jelajahi Roadmap
        </h2>
        <p class="max-w-[900px] text-gray-500 md:text-xl/relaxed">
          Cari atau jelajahi jalur belajar yang telah dibuat sebelumnya.
        </p>
      </div>
      <div class="max-w-xl mx-auto my-8">
        <input
          type="search"
          id="search-box"
          placeholder="Cari roadmap berdasarkan judul..."
          class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 transition"
        />
      </div>

      <div
        id="roadmap-grid"
        class="mx-auto grid max-w-5xl grid-cols-1 gap-6 py-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8"
      >
        {
          roadmaps.length > 0 ? (
            roadmaps.map((roadmap) => (
              <a
                href={`/roadmap/${roadmap.slug}`}
                class="roadmap-card group block rounded-lg border bg-white shadow-sm hover:shadow-lg transition-shadow duration-300 transform hover:-translate-y-1"
                data-title={roadmap.title.toLowerCase()}
              >
                <div class="flex flex-col p-6 h-full">
                  {roadmap.category && roadmap.category && (
                    <span class="mb-2 inline-block rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800 self-start">
                      {roadmap.category.name}
                    </span>
                  )}
                  <h3 class="text-xl font-semibold ...">{roadmap.title}</h3>
                  <p class="text-sm text-gray-500 ...">
                    {roadmap.description.substring(0, 100)}...
                  </p>
                </div>
              </a>
            ))
          ) : (
            <p
              id="no-results-message"
              class="text-center col-span-3 text-gray-500"
            >
              Belum ada roadmap yang dibuat.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <footer class="bg-gray-800 text-gray-400">
    <div
      class="container mx-auto py-6 px-4 md:px-6 flex flex-col sm:flex-row justify-between items-center text-sm"
    >
      <p>
        &copy; {new Date().getFullYear()} AI Learning Path Generator. All rights
        reserved.
      </p>
      <p class="mt-2 sm:mt-0">
        Built with ❤️ by <a
          href="https://github.com/your-username"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-gray-300 hover:text-white">dannyysaputra</a
        >
      </p>
    </div>
  </footer>
</Layout>

<script>
  // Mengambil semua elemen dari DOM
  const form = document.getElementById("topic-form");
  const submitButton = document.getElementById("submit-button");
  const buttonText = document.getElementById("button-text");
  const loadingSpinner = document.getElementById("loading-spinner");
  const errorMessage = document.getElementById("error-message");

  if (form && submitButton && buttonText && loadingSpinner && errorMessage) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // UI state: loading
      submitButton.setAttribute("disabled", "true");
      buttonText.classList.add("hidden");
      loadingSpinner.classList.remove("hidden");
      errorMessage.textContent = "";

      const formData = new FormData(form as HTMLFormElement);
      const topic = formData.get("topic");

      try {
        const response = await fetch("/api/generate-roadmap", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ topic }),
        });

        if (!response.ok) {
          throw new Error(`Terjadi kesalahan: ${response.statusText}`);
        }

        const result = await response.json();

        // Redirect ke halaman roadmap baru
        window.location.href = `/roadmap/${result.slug}`;
      } catch (error) {
        console.error("Gagal membuat roadmap:", error);
        errorMessage.textContent =
          "Gagal membuat jalur belajar. Silakan coba lagi.";

        // UI state: reset
        submitButton.removeAttribute("disabled");
        buttonText.classList.remove("hidden");
        loadingSpinner.classList.add("hidden");
      }
    });
  }

  const searchBox = document.getElementById("search-box");
  const roadmapGrid = document.getElementById("roadmap-grid");
  const allCards = roadmapGrid
    ? Array.from(roadmapGrid.getElementsByClassName("roadmap-card"))
    : [];
  const noResultsMessage = document.getElementById("no-results-message");

  if (searchBox instanceof HTMLInputElement) {
    searchBox.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      const searchTerm = target.value.toLowerCase();
      let visibleCount = 0;

      allCards.forEach((element) => {
        const card = element as HTMLElement;
        const title = card.getAttribute("data-title");

        if (title && title.includes(searchTerm)) {
          card.style.display = "block";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (noResultsMessage) {
        (noResultsMessage as HTMLElement).style.display =
          visibleCount === 0 ? "block" : "none";
        if (visibleCount === 0) {
          noResultsMessage.textContent =
            "Tidak ada roadmap yang cocok dengan pencarian Anda.";
        }
      }
    });
  }
</script>
